# Copy to .env and fill in values. Never commit .env.

PORT=3001
APP_URL=http://localhost:5173

# Turso (required for cloud DB). For local-only testing you can use:
# TURSO_URL=file:local.db
# TURSO_TOKEN=
TURSO_URL=
TURSO_TOKEN=

JWT_SECRET=change-me-to-a-long-random-string

ADMIN_EMAIL=admin@buildbot.local
ADMIN_PASSWORD=Admin123!

TEST_MODE=true
EMAIL_TEST_MODE=true
CRON_ENABLED=false

# AI-powered recommendations (optional — falls back to the rule-based
# catalog heuristic when ANTHROPIC_API_KEY is unset):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_MAX_TOKENS=4096
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# RESEND_EMAIL_4TEST=
# GOOGLE_CLIENT_ID=
